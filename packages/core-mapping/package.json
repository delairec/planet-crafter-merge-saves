{
  "name": "core-mapping",
  "version": "1.0.0",
  "description": "Domain/application/infrastructure/presentation mapping for Planet Crafter save files",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "lint:types": "tsc --noEmit",
    "build:node": "bun build src/controllers/MergeSaveFilesController.ts src/controllers/ValidateSaveFileController.ts --target=node --format=esm --outdir dist/controllers",
    "clean:node": "rm -rf dist"
  },
  "exports": {
    "./controllers/*": {
      "node-bundle": "./dist/controllers/*.js",
      "default": "./src/controllers/*.ts"
    },
    "./presentation/viewModels/*": "./src/presentation/viewModels/*.ts"
  },
  "dependencies": {
    "ajv": "catalog:testing",
    "shared-save-processing": "workspace:*"
  }
}
