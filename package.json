{
  "name": "planet-crafter-save-tools",
  "version": "1.0.0",
  "description": "A set of tools to manipulate Planet Crafter save files",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "packages/cli-merge",
      "packages/cli-validate",
      "packages/ui-save-manager"
    ]
  },
  "type": "module",
  "main": "packages/cli-merge/cli/merge-cli.js",
  "scripts": {
    "clean": "rm -rf node_modules",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint:types": "tsc --noEmit",
    "build:ui": "bun run --filter ui-save-manager build",
    "audit:quality": "bun run fallow:quality && bun run fallow:health",
    "fallow:quality": "fallow audit --config ./fallow.toml --base master --no-cache --ci",
    "fallow:quality:local": "fallow audit --config ./fallow.toml --base master --no-cache",
    "fallow:health": "fallow health --config ./fallow.toml --base master --no-cache --ci",
    "fallow:health:local": "fallow health --config ./fallow.toml --base master --no-cache",
    "audit": "bun audit --audit-level=high --ignore=GHSA-3v7f-55p6-f55p --ignore=GHSA-c2c7-rcm5-vvqj",
    "dev:ui": "bun run --filter ui-save-manager dev",
    "preview:ui": "bun run --filter ui-save-manager preview",
    "clean:ui": "bun run --filter ui-save-manager clean",
    "merge": "bun run --filter cli-merge merge",
    "clean:merge": "rm -rf output",
    "test:merge": "bun test --filter cli-merge",
    "validate": "bun run --filter cli-validate validate",
    "test:validate": "bun test --filter cli-validate",
    "node:merge": "node packages/cli-merge/cli/merge-cli.js --platform=node",
    "node:validate": "node packages/cli-validate/cli/validate-cli.js --platform=node"
  },
  "catalogs": {
    "typescript": {
      "@types/bun": "^1.3.14",
      "typescript": "^7.0.2"
    },
    "testing": {
      "ajv": "^8.20.0"
    }
  },
  "devDependencies": {
    "@types/bun": "catalog:typescript",
    "fallow": "3.14.0",
    "typescript": "catalog:typescript",
    "ui-save-manager": "workspace:*"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "bun": "^1.3.14"
  }
}
